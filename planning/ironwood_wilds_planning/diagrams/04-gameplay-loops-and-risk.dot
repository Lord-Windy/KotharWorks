digraph GameplayLoops {
    graph [
        rankdir=LR,
        bgcolor="#0f1419",
        fontname="Liberation Sans",
        fontsize=14,
        fontcolor="#e6edf3",
        label=<<b>Ironwood Wilds — Interlocking Gameplay Loops, Personas &amp; Asymmetric Risk</b><br/><font point-size="11" color="#8b949e">Zero PvP · Patient Hands + Living Personas · Mortal Skills x Permanent Tech Tree · Chronicle Resets</font>>,
        labelloc=t,
        pad="0.40",
        nodesep="0.45",
        ranksep="0.75"
    ];

    node [
        shape=box,
        style="rounded,filled",
        fontname="Liberation Sans",
        fontsize=10.5,
        fillcolor="#161b22",
        color="#30363d",
        fontcolor="#e6edf3",
        margin="0.16,0.10"
    ];

    edge [
        fontname="Liberation Sans",
        fontsize=9,
        color="#8b949e",
        fontcolor="#9ca3af",
        penwidth=1.3,
        arrowsize=0.75
    ];

    subgraph cluster_micro {
        label=<<b>1. Character Micro Loop (Tabs)</b>>;
        fontcolor="#58a6ff";
        color="#1f3a5f";
        bgcolor="#121924";
        style="rounded,filled";

        roster [
            fillcolor="#1b2738",
            color="#58a6ff",
            label=<<b>Household Roster (3 -&gt; 20 People)</b><br/><font point-size="9" color="#9ca3af">0% idle wandering · Procedural Personas &amp; Journals<br/>Individual Skills Lv.1–99 (XP dies with person!)</font>>
        ];

        gather_craft [
            fillcolor="#1b2738",
            color="#58a6ff",
            label=<<b>Timed Gathering &amp; Artisanry</b><br/><font point-size="9" color="#9ca3af">Ash, Bog-Iron, Hematite, Scarce True Ironwood<br/>Charcoal -&gt; Bloomery -&gt; Steel &amp; Rations</font>>
        ];
    }

    subgraph cluster_meso {
        label=<<b>2. Household Meso Progression</b>>;
        fontcolor="#3fb950";
        color="#1f4729";
        bgcolor="#111b14";
        style="rounded,filled";

        tech_tree [
            fillcolor="#16281c",
            color="#3fb950",
            label=<<b>Household Tech Tree (Tiers I–IV)</b><br/><font point-size="9" color="#7ee787">Survives PvM character wipes!<br/>Bloomery -&gt; Stone Walls -&gt; Ironwood Works</font>>
        ];

        hold_castle [
            fillcolor="#16281c",
            color="#3fb950",
            label=<<b>3-Ring Hold / Castle Construction</b><br/><font point-size="9" color="#7ee787">1. Outer Works (Palisade, Curtain Wall, Gate)<br/>2. Bailey Workshops · 3. Vaulted Keep</font>>
        ];
    }

    subgraph cluster_macro {
        label=<<b>3. Macro Pressures, Risk &amp; Tithe Ship</b>>;
        fontcolor="#d29922";
        color="#4a3919";
        bgcolor="#181512";
        style="rounded,filled";

        hold_raids [
            fillcolor="#2b2113",
            color="#d29922",
            penwidth=1.6,
            label=<<b>Hold Raids (NON-LETHAL)</b><br/><font point-size="9" color="#f2cc60">Rumor Warning + HoldDefenseDoctrine<br/>0 Permadeath! Only unvaulted Bailey<br/>stock &amp; wall condition at risk</font>>
        ];

        pvm_delves [
            fillcolor="#301619",
            color="#f85149",
            penwidth=1.6,
            label=<<b>PvM Party Expeditions (LETHAL)</b><br/><font point-size="9" color="#ffa198">2–5 Person Party + CombatDoctrine Gambits<br/>Risk: Permadeath, Scars &amp; Cairn Epitaphs!<br/>Reward: Barrow Relics &amp; Myth Clues</font>>
        ];

        homeworld_supply [
            fillcolor="#211b30",
            color="#bc8cff",
            penwidth=1.6,
            label=<<b>Homeland Tithe Ship &amp; Beacon</b><br/><font point-size="9" color="#d2a8ff">Stage Goods -&gt; Scheduled Ship Arrival<br/>Earn Supply Favor + Public Chronicle Dispatch</font>>
        ];
    }

    roster -> gather_craft [label=" Queue 1..5 actions", color="#58a6ff"];
    gather_craft -> roster [label=" Skill XP + Journal Lines", color="#58a6ff", style=dashed, constraint=false];

    gather_craft -> tech_tree [label=" Lore + Samples", color="#3fb950"];
    tech_tree -> gather_craft [label=" Unlocks Tools & Recipes", color="#3fb950", style=dashed, constraint=false];

    gather_craft -> hold_castle [label=" Timber, Stone, Iron", color="#3fb950"];
    tech_tree -> hold_castle [label=" Unlocks Fortifications", color="#3fb950"];

    hold_castle -> hold_raids [label=" Walls + Vault Cap mitigate", color="#d29922"];
    hold_raids -> hold_castle [label=" Damages Condition / Loots Bailey", color="#d29922", style=dashed, constraint=false];

    gather_craft -> pvm_delves [label=" Equip Vanguard Party", color="#f85149"];
    pvm_delves -> tech_tree [label=" Tier III/IV Relic Salvage", color="#f85149", constraint=false];
    pvm_delves -> roster [label=" Casualties drain skilled veterans!", color="#f85149", style=dotted, constraint=false];

    gather_craft -> homeworld_supply [label=" Stage at Signal Beacon", color="#bc8cff"];
    homeworld_supply -> roster [label=" Spend Favor -> Recruit New People!", color="#bc8cff", penwidth=1.8, constraint=false];
}
