digraph PostgresSchemas {
    graph [
        rankdir=LR,
        bgcolor="#0f1419",
        fontname="Liberation Sans",
        fontsize=14,
        fontcolor="#e6edf3",
        label=<<b>PostgreSQL Three-Schema Persistence: Command-Log Truth + Checkpoints</b><br/><font point-size="11" color="#8b949e">Plain SQL + JDBI + ~100-LOC Migrator · Replay Version-Triple · Scoped Multi-House Bot/GA Tokens</font>>,
        labelloc=t,
        pad="0.40",
        nodesep="0.42",
        ranksep="0.80"
    ];

    node [
        shape=plain,
        fontname="Liberation Sans",
        fontsize=10,
        fontcolor="#e6edf3"
    ];

    edge [
        fontname="Liberation Sans",
        fontsize=8.5,
        color="#8b949e",
        fontcolor="#9ca3af",
        penwidth=1.3,
        arrowsize=0.75
    ];

    subgraph cluster_auth {
        label=<<b>Schema 1: auth</b>  <font point-size="9" color="#79c0ff">(OIDC Identity Links &amp; Bot Keys · Zero Passwords · Never Wiped)</font>>;
        fontcolor="#58a6ff";
        color="#1f3a5f";
        bgcolor="#121924";
        style="rounded,filled";

        auth_accounts [label=<
            <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#182232" COLOR="#388bfd">
                <TR><TD BGCOLOR="#1f324d" ALIGN="LEFT"><B><FONT COLOR="#79c0ff">auth.users &amp; identity_links</FONT></B></TD></TR>
                <TR><TD ALIGN="LEFT"><FONT FACE="Liberation Mono">PK user_id (UUID) · display_name</FONT></TD></TR>
                <TR><TD ALIGN="LEFT"><FONT FACE="Liberation Mono">PK (issuer, subject) -&gt; FK user_id</FONT></TD></TR>
                <TR><TD ALIGN="LEFT"><FONT FACE="Liberation Mono">suspended_at · max_houses_override</FONT></TD></TR>
            </TABLE>
        >];

        auth_tokens [label=<
            <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#182232" COLOR="#388bfd">
                <TR><TD BGCOLOR="#1f324d" ALIGN="LEFT"><B><FONT COLOR="#79c0ff">auth.web_sessions &amp; api_tokens</FONT></B></TD></TR>
                <TR><TD ALIGN="LEFT"><FONT FACE="Liberation Mono">session_sha256 · granted_roles[] (JWT)</FONT></TD></TR>
                <TR><TD ALIGN="LEFT"><FONT FACE="Liberation Mono">token_sha256 (iw_bot_&lt;prefix8&gt;_...)</FONT></TD></TR>
                <TR><TD ALIGN="LEFT"><FONT FACE="Liberation Mono">scoped_resource_id (house_id) · rate</FONT></TD></TR>
            </TABLE>
        >];
    }

    subgraph cluster_meta {
        label=<<b>Schema 2: wilds_meta</b>  <font point-size="9" color="#d2a8ff">(Hall of Chronicles · Never Wiped)</font>>;
        fontcolor="#bc8cff";
        color="#3b2354";
        bgcolor="#171221";
        style="rounded,filled";

        meta_houses [label=<
            <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#211930" COLOR="#8957e5">
                <TR><TD BGCOLOR="#2f2047" ALIGN="LEFT"><B><FONT COLOR="#d2a8ff">wilds_meta.houses</FONT></B></TD></TR>
                <TR><TD ALIGN="LEFT"><FONT FACE="Liberation Mono">PK house_id · FK owner_user_id (UUID)</FONT></TD></TR>
                <TR><TD ALIGN="LEFT"><FONT FACE="Liberation Mono">house_name · motto</FONT></TD></TR>
                <TR><TD ALIGN="LEFT"><FONT FACE="Liberation Mono">controller_kind (HUMAN|SCRIPT_BOT|GA)</FONT></TD></TR>
                <TR><TD ALIGN="LEFT"><FONT FACE="Liberation Mono">lifetime_favor · chronicles_run</FONT></TD></TR>
            </TABLE>
        >];

        meta_chronicles [label=<
            <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#211930" COLOR="#8957e5">
                <TR><TD BGCOLOR="#2f2047" ALIGN="LEFT"><B><FONT COLOR="#d2a8ff">chronicles &amp; standings</FONT></B></TD></TR>
                <TR><TD ALIGN="LEFT"><FONT FACE="Liberation Mono">world_seed · myth_flags_json</FONT></TD></TR>
                <TR><TD ALIGN="LEFT"><FONT FACE="Liberation Mono">rules/engine/protocol + jvm_version</FONT></TD></TR>
                <TR><TD ALIGN="LEFT"><FONT FACE="Liberation Mono">supply_favor_earned · epitaph</FONT></TD></TR>
            </TABLE>
        >];

        meta_blueprints [label=<
            <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#211930" COLOR="#8957e5">
                <TR><TD BGCOLOR="#2f2047" ALIGN="LEFT"><B><FONT COLOR="#d2a8ff">doctrine_blueprints &amp; genomes</FONT></B></TD></TR>
                <TR><TD ALIGN="LEFT"><FONT FACE="Liberation Mono">Saved Raid &amp; Party Gambit JSON</FONT></TD></TR>
                <TR><TD ALIGN="LEFT"><FONT FACE="Liberation Mono">Archived SamVM Champion Blobs</FONT></TD></TR>
            </TABLE>
        >];
    }

    subgraph cluster_world {
        label=<<b>Schema 3: wilds_world</b>  <font point-size="9" color="#7ee787">(Active Chronicle · Archived &amp; Truncated on Reset)</font>>;
        fontcolor="#3fb950";
        color="#1f4729";
        bgcolor="#101a14";
        style="rounded,filled";

        world_wal [label=<
            <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#16241b" COLOR="#2ea043">
                <TR><TD BGCOLOR="#1d3826" ALIGN="LEFT"><B><FONT COLOR="#7ee787">command_wal (TRUTH) &amp; checkpoints</FONT></B></TD></TR>
                <TR><TD ALIGN="LEFT"><FONT FACE="Liberation Mono">wal_seq · admitted_ms · UNIQUE(cmd_id)</FONT></TD></TR>
                <TR><TD ALIGN="LEFT"><FONT FACE="Liberation Mono">up_to_wal_seq · world_hash · state_json</FONT></TD></TR>
                <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#9ca3af">Boot = Snapshot + WAL Tail · PAUSE_WHILE_DOWN</FONT></TD></TR>
            </TABLE>
        >];

        world_proj [label=<
            <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#16241b" COLOR="#2ea043">
                <TR><TD BGCOLOR="#1d3826" ALIGN="LEFT"><B><FONT COLOR="#7ee787">Rebuildable Projections</FONT></B></TD></TR>
                <TR><TD ALIGN="LEFT"><FONT FACE="Liberation Mono">chronicle_events (+ fogged public_rumor)</FONT></TD></TR>
                <TR><TD ALIGN="LEFT"><FONT FACE="Liberation Mono">characters_live (+ persona_json)</FONT></TD></TR>
                <TR><TD ALIGN="LEFT"><FONT FACE="Liberation Mono">holds_live · battle_chronicles</FONT></TD></TR>
            </TABLE>
        >];
    }

    auth_accounts -> auth_tokens [label="1:N"];
    auth_accounts -> meta_houses [label="1:N houses", color="#bc8cff"];
    auth_tokens -> meta_houses [label="scopes bot key", style=dashed, color="#58a6ff"];
    meta_houses -> meta_blueprints [label="persists across wipes", color="#bc8cff"];
    meta_houses -> meta_chronicles [label="epitaph + stats", color="#bc8cff"];

    meta_chronicles -> world_wal [label="active seed", color="#3fb950"];
    world_wal -> world_proj [label="projected from truth", color="#3fb950"];
    world_proj -> meta_chronicles [label="Archive on Season End", style=dashed, color="#d29922"];
}
