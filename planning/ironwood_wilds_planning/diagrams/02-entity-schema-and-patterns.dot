digraph EntitySchemaAndPatterns {
    graph [
        rankdir=LR,
        bgcolor="#0f1419",
        fontname="Liberation Sans",
        fontsize=15,
        fontcolor="#e6edf3",
        label=<<b>Data-Oriented Entity Schema + Classic GoF Design Patterns in Java 25</b><br/><font point-size="11" color="#8b949e">Dense generational tables (index, generation) · Zero floats · GoF patterns drive behavior &amp; extensibility</font>>,
        labelloc=t,
        pad="0.40",
        nodesep="0.40",
        ranksep="0.85"
    ];

    node [
        shape=plain,
        fontname="Liberation Sans",
        fontsize=10,
        fontcolor="#e6edf3"
    ];

    edge [
        fontname="Liberation Mono",
        fontsize=8.5,
        color="#6e7681",
        fontcolor="#8b949e",
        penwidth=1.2,
        arrowsize=0.75
    ];

    subgraph cluster_gof {
        label=<<b>1. GoF Behavior &amp; Rule Seams (Stateless / Immutable)</b>>;
        fontcolor="#d29922";
        color="#4a3919";
        bgcolor="#151921";
        style="rounded,filled";

        cmd_pattern [label=<
            <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#1f242d" COLOR="#d29922">
                <TR><TD BGCOLOR="#2d2312" ALIGN="LEFT"><B><FONT COLOR="#f2cc60">«Command Pattern» sealed WorldCommand</FONT></B></TD></TR>
                <TR><TD ALIGN="LEFT">• EnqueueActions / ReplacePendingQueue / CancelQueue</TD></TR>
                <TR><TD ALIGN="LEFT">• StartBuilding / WriteHoldDoctrine (+ expectedRevision)</TD></TR>
                <TR><TD ALIGN="LEFT">• StageShipment / RecruitSettler / FormAndDispatchParty</TD></TR>
                <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#8b949e">POST /api/v1/commands · cmdId UUIDv7 + ETag expectedRevision</FONT></TD></TR>
            </TABLE>
        >];

        strategy_pattern [label=<
            <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#1f242d" COLOR="#58a6ff">
                <TR><TD BGCOLOR="#15263d" ALIGN="LEFT"><B><FONT COLOR="#79c0ff">«Strategy Pattern» Mechanics &amp; Formulas</FONT></B></TD></TR>
                <TR><TD ALIGN="LEFT">• ActionMechanic&lt;P&gt;: validateEnqueue / planStart / onComplete</TD></TR>
                <TR><TD ALIGN="LEFT">• RaidResolutionStrategy (Non-lethal, 3-Ring Vault-aware)</TD></TR>
                <TR><TD ALIGN="LEFT">• ExpeditionResolutionStrategy (Lethal PvM Autobattler)</TD></TR>
                <TR><TD ALIGN="LEFT">• XpCurve / DurationFormula · Bot Doctrine Seam</TD></TR>
            </TABLE>
        >];

        prototype_pattern [label=<
            <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#1f242d" COLOR="#bc8cff">
                <TR><TD BGCOLOR="#261936" ALIGN="LEFT"><B><FONT COLOR="#d2a8ff">«Prototype / Flyweight» Compile-Time Rules</FONT></B></TD></TR>
                <TR><TD ALIGN="LEFT">• ItemDef · SkillDef · RecipeDef (RuleId)</TD></TR>
                <TR><TD ALIGN="LEFT">• BuildingDef (OUTER_WORKS | BAILEY | KEEP)</TD></TR>
                <TR><TD ALIGN="LEFT">• TechNodeDef · ProseCatalog · PersonaCatalog</TD></TR>
                <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#8b949e">Zero file I/O in libs/* · Served verbatim at GET /api/v1/rules</FONT></TD></TR>
            </TABLE>
        >];
    }

    subgraph cluster_tables {
        label=<<b>2. WorldState Dense Generational Tables (Zero Object Pointers, Zero Floats)</b>>;
        fontcolor="#3fb950";
        color="#1f4729";
        bgcolor="#101914";
        style="rounded,filled";

        household_tbl [label=<
            <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#16221b" COLOR="#2ea043">
                <TR><TD BGCOLOR="#1b3624" ALIGN="LEFT"><B><FONT COLOR="#7ee787">HouseholdRow</FONT></B></TD></TR>
                <TR><TD ALIGN="LEFT"><FONT FACE="Liberation Mono">PK HouseholdId(index, gen)</FONT></TD></TR>
                <TR><TD ALIGN="LEFT"><FONT FACE="Liberation Mono">FK HoldId primaryHoldId</FONT></TD></TR>
                <TR><TD ALIGN="LEFT"><FONT FACE="Liberation Mono">Set&lt;RuleId&gt; unlockedTechs</FONT></TD></TR>
                <TR><TD ALIGN="LEFT"><FONT FACE="Liberation Mono">long supplyFavor · List&lt;FallenMemorial&gt;</FONT></TD></TR>
            </TABLE>
        >];

        char_tbl [label=<
            <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#16221b" COLOR="#2ea043">
                <TR><TD BGCOLOR="#1b3624" ALIGN="LEFT"><B><FONT COLOR="#7ee787">CharacterRow (+ CharacterPersona)</FONT></B></TD></TR>
                <TR><TD ALIGN="LEFT"><FONT FACE="Liberation Mono">PK CharacterId(index, gen) · long revision</FONT></TD></TR>
                <TR><TD ALIGN="LEFT"><FONT FACE="Liberation Mono">CharacterPersona (Origin, Voice, Quirk, Scars)</FONT></TD></TR>
                <TR><TD ALIGN="LEFT"><FONT FACE="Liberation Mono">int health · LazyGauge staminaMilli (int!)</FONT></TD></TR>
                <TR><TD ALIGN="LEFT"><FONT FACE="Liberation Mono">SkillSheet · EquipmentLoadout · JournalSeeds</FONT></TD></TR>
                <TR><TD ALIGN="LEFT"><FONT FACE="Liberation Mono">ActiveAction(heapTicket) + Queue[0..5]</FONT></TD></TR>
            </TABLE>
        >];

        hold_tbl [label=<
            <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#16221b" COLOR="#2ea043">
                <TR><TD BGCOLOR="#1b3624" ALIGN="LEFT"><B><FONT COLOR="#7ee787">HoldRow &amp; BuildingRow</FONT></B></TD></TR>
                <TR><TD ALIGN="LEFT"><FONT FACE="Liberation Mono">PK HoldId(index, gen) · long revision</FONT></TD></TR>
                <TR><TD ALIGN="LEFT"><FONT FACE="Liberation Mono">Stockpile baileyStock + beaconStagedStock</FONT></TD></TR>
                <TR><TD ALIGN="LEFT"><FONT FACE="Liberation Mono">int vaultProtectedCap · long awarenessMilli</FONT></TD></TR>
                <TR><TD ALIGN="LEFT"><FONT FACE="Liberation Mono">HoldDefenseDoctrine · List&lt;BuildingId&gt;</FONT></TD></TR>
            </TABLE>
        >];

        party_site_tbl [label=<
            <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#16221b" COLOR="#2ea043">
                <TR><TD BGCOLOR="#1b3624" ALIGN="LEFT"><B><FONT COLOR="#7ee787">PartyRow &amp; SiteDeltaRow</FONT></B></TD></TR>
                <TR><TD ALIGN="LEFT"><FONT FACE="Liberation Mono">PK PartyId · List&lt;CharacterId&gt; roster</FONT></TD></TR>
                <TR><TD ALIGN="LEFT"><FONT FACE="Liberation Mono">CombatDoctrine · FK SiteId target</FONT></TD></TR>
                <TR><TD ALIGN="LEFT"><FONT FACE="Liberation Mono">TreeMap&lt;SiteIdx, SiteDeltaRow&gt; depletion</FONT></TD></TR>
            </TABLE>
        >];
    }

    subgraph cluster_out {
        label=<<b>3. Outward Observer &amp; Fog Projections</b>>;
        fontcolor="#f0883e";
        color="#523018";
        bgcolor="#171412";
        style="rounded,filled";

        events_out [label=<
            <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#241c17" COLOR="#f0883e">
                <TR><TD BGCOLOR="#382414" ALIGN="LEFT"><B><FONT COLOR="#ffa657">«Observer» sealed WorldEvent</FONT></B></TD></TR>
                <TR><TD ALIGN="LEFT">• Monotonic cursor (?since=410)</TD></TR>
                <TR><TD ALIGN="LEFT">• ActionCompleted / Failed / LevelUp</TD></TR>
                <TR><TD ALIGN="LEFT">• ShipmentDeparted / RumorHeard</TD></TR>
                <TR><TD ALIGN="LEFT">• RaidResolved / ColonistDied</TD></TR>
            </TABLE>
        >];

        projector_out [label=<
            <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#241c17" COLOR="#f0883e">
                <TR><TD BGCOLOR="#382414" ALIGN="LEFT"><B><FONT COLOR="#ffa657">ObservationProjector &amp; WorldHash</FONT></B></TD></TR>
                <TR><TD ALIGN="LEFT">• Fog-strips unscouted regions &amp; rivals</TD></TR>
                <TR><TD ALIGN="LEFT">• Emits fogged public Chronicle rumors</TD></TR>
                <TR><TD ALIGN="LEFT">• WorldHash structural digest (M0 gate)</TD></TR>
            </TABLE>
        >];
    }

    cmd_pattern -> strategy_pattern [label="dispatches to", color="#d29922"];
    prototype_pattern -> strategy_pattern [label="parameterizes", color="#bc8cff"];

    strategy_pattern -> household_tbl [color="#58a6ff"];
    strategy_pattern -> char_tbl [color="#58a6ff"];
    strategy_pattern -> hold_tbl [color="#58a6ff"];
    strategy_pattern -> party_site_tbl [color="#58a6ff"];

    char_tbl -> household_tbl [label="householdId", style=dashed, color="#3fb950"];
    hold_tbl -> household_tbl [label="ownerId", style=dashed, color="#3fb950"];
    party_site_tbl -> char_tbl [label="roster IDs", style=dashed, color="#3fb950"];

    household_tbl -> projector_out [color="#f0883e"];
    char_tbl -> projector_out [color="#f0883e"];
    hold_tbl -> events_out [color="#f0883e"];
    char_tbl -> events_out [color="#f0883e"];
}
