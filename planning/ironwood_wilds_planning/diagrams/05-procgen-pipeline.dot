digraph ProcgenPipeline {
    graph [
        rankdir=TB,
        bgcolor="#0f1419",
        fontname="Liberation Sans",
        fontsize=14,
        fontcolor="#e6edf3",
        label=<<b>libs/procgen — Seeded World, Myth, Character Persona &amp; Prose Engine</b><br/><font point-size="11" color="#8b949e">Zero LLMs · Zero Runtime Deps · Zero File I/O · 100% Deterministic from 64-bit WorldSeed</font>>,
        labelloc=t,
        pad="0.40",
        nodesep="0.38",
        ranksep="0.56"
    ];

    node [
        shape=box,
        style="rounded,filled",
        fontname="Liberation Sans",
        fontsize=10.5,
        fillcolor="#161b22",
        color="#30363d",
        fontcolor="#e6edf3",
        margin="0.14,0.10"
    ];

    edge [
        fontname="Liberation Sans",
        fontsize=9,
        color="#8b949e",
        fontcolor="#9ca3af",
        penwidth=1.3,
        arrowsize=0.75
    ];

    seed [
        fillcolor="#2b2013",
        color="#f0883e",
        penwidth=1.8,
        label=<<b>WorldSeed(long value)</b><br/><font point-size="9" color="#ffa657">stream(domain, coordA, coordB) -&gt; FNV-1a + SplitMix64 Integer SeededRng<br/>Visitation-Order Independent (Domain edits never shift ore veins!)</font>>
    ];

    subgraph cluster_macro {
        label=<<b>Scale 1: Geography, Waypoints &amp; Myth</b>>;
        fontcolor="#3fb950";
        color="#1f4729";
        bgcolor="#101a14";
        style="rounded,filled";

        fields [label=<<b>Multi-Pass Region Fields</b><br/><font point-size="9" color="#9ca3af">Elevation (Simplex+Warp) · Hydrology<br/>Climate Lapse · Whittaker Biomes</font>>];
        ecology [label=<<b>Deposits &amp; True Ironwood Cap</b><br/><font point-size="9" color="#7ee787">Poisson-Disc Seams + &lt;=2 Ironwood Groves<br/>Precomputed Site/Waypoint Travel Graph</font>>];
        myth [label=<<b>Chronicle MythFlags</b><br/><font point-size="9" color="#d2a8ff">3–5 Seeded Rival/Mystery Facts<br/>Feeds Rumors, Ruins &amp; Climax Raid</font>>];
    }

    subgraph cluster_people {
        label=<<b>Scale 2: Living Personas &amp; Journals</b>>;
        fontcolor="#d29922";
        color="#4a3919";
        bgcolor="#181510";
        style="rounded,filled";

        names [label=<<b>Phonotactic NameGrammar</b><br/><font point-size="9" color="#f2cc60">Given · Surname · Place · Lair<br/>Strict Low-Fantasy (0 Apostrophes!)</font>>];
        persona [label=<<b>PersonaGenerator</b><br/><font point-size="9" color="#9ca3af">Homeland Origin · Temperament Voice<br/>Habit Quirk · Earned Scars &amp; Grief</font>>];
        journal [label=<<b>First-Person JournalComposer</b><br/><font point-size="9" color="#f2cc60">(EventKind x Temperament) Diary Lines<br/>Wry vs Stoic vs Superstitious Voice!</font>>];
    }

    subgraph cluster_meso_micro {
        label=<<b>Scales 3 &amp; 4: Lairs &amp; Hierarchical Prose (procgen_mvp)</b>>;
        fontcolor="#58a6ff";
        color="#1f3a5f";
        bgcolor="#121924";
        style="rounded,filled";

        lair_dag [label=<<b>PvM Lair Room DAG</b><br/><font point-size="9" color="#ffa198">Scout Check -&gt; Outer Pack<br/>-&gt; Mining/Lore Branch -&gt; Alpha</font>>];
        prose [label=<<b>Compile-Time ProseCatalog + ProseContext</b><br/><font point-size="9" color="#79c0ff">Categories · Slots · Plurals · Wear · Myth<br/>Outputs: <b>glance</b> · <b>look</b> · <b>examine</b></font>>];
    }

    seed -> fields [label=" 'geo'", color="#f0883e"];
    seed -> myth [label=" 'myth'", color="#f0883e"];
    seed -> names [label=" 'names'", color="#f0883e"];
    seed -> persona [label=" 'persona'", color="#f0883e"];
    seed -> lair_dag [label=" 'lair'", color="#f0883e"];

    fields -> ecology [color="#3fb950"];
    names -> persona -> journal [color="#d29922"];
    ecology -> lair_dag [style=dashed, color="#3fb950"];
    myth -> prose [style=dashed, color="#bc8cff"];
    myth -> journal [style=dashed, color="#bc8cff"];
    persona -> prose [label=" Idle Quirk &amp; Scars", style=dashed, color="#d29922"];
}
