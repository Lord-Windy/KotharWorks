digraph FridayRoadmap {
    graph [
        rankdir=LR,
        bgcolor="#0f1419",
        fontname="Liberation Sans",
        fontsize=14,
        fontcolor="#e6edf3",
        label=<<b>Milestones M0–M5 Across 12 Fridays — Ticketed &amp; Review-Gated</b><br/><font point-size="11" color="#8b949e">Every ticket gated by mvnd test (-Werror), zero-float WorldState purity, and WorldHash parity</font>>,
        labelloc=t,
        pad="0.38",
        nodesep="0.38",
        ranksep="0.55"
    ];

    node [
        shape=box,
        style="rounded,filled",
        fontname="Liberation Sans",
        fontsize=10,
        fillcolor="#161b22",
        color="#30363d",
        fontcolor="#e6edf3",
        margin="0.13,0.09"
    ];

    edge [
        color="#6e7681",
        penwidth=1.3,
        arrowsize=0.72
    ];

    f1 [fillcolor="#132419", color="#3fb950", label=<<b>F1 (M0): Kernel &amp; Hash</b><br/><font point-size="8.5" color="#7ee787">EntityTable · Int LazyGauge<br/>DueEventHeap · wilds-headless</font>>];
    f2 [fillcolor="#261d14", color="#f0883e", label=<<b>F2 (M1a): World &amp; Myth</b><br/><font point-size="8.5" color="#ffa657">Region Passes · Waypoint Map<br/>MythFlags · ASCII Gallery</font>>];
    f3 [fillcolor="#261d14", color="#f0883e", label=<<b>F3 (M1b): Personas &amp; Prose</b><br/><font point-size="8.5" color="#ffa657">NameGrammar · Personas/Journals<br/>glance/look/examine + Gather</font>>];
    f4 [fillcolor="#132419", color="#3fb950", label=<<b>F4 (M2): Economy Loop</b><br/><font point-size="8.5" color="#7ee787">Skills · Tech · Craft/Build<br/>Tithe Ship -&gt; Favor -&gt; Recruit</font>>];

    f5 [fillcolor="#132419", color="#3fb950", label=<<b>F5 (M3): Raids &amp; PvM</b><br/><font point-size="8.5" color="#7ee787">3-Ring Hold (0 Raid Deaths)<br/>Lethal Delves · Scars &amp; Cairn</font>>];
    f6 [fillcolor="#142030", color="#58a6ff", label=<<b>F6 (M4a): Auth + HTTP + SSE</b><br/><font point-size="8.5" color="#79c0ff">libs/auth (Dev JWT + Bot Keys)<br/>WorldHost + POST /commands + SSE</font>>];
    f7 [fillcolor="#261f12", color="#d29922", label=<<b>F7 (M4b): /play Multi-Tab</b><br/><font point-size="8.5" color="#f2cc60">Away Digest · Persona/Journal<br/>60fps Local Timers · Doctrines</font>>];
    f8 [fillcolor="#142030", color="#58a6ff", label=<<b>F8 (M4c): Postgres &amp; OIDC</b><br/><font point-size="8.5" color="#79c0ff">auth · wilds_meta · wilds_world<br/>Keycloak OIDC + Replay Parity!</font>>];

    f9 [fillcolor="#142030", color="#58a6ff", label=<<b>F9 (M5a): wilds-bot</b><br/><font point-size="8.5" color="#79c0ff">Doctrine Seam over HTTP/SSE<br/>10-Bot Headless CI Soak</font>>];
    f10 [fillcolor="#261f12", color="#d29922", label=<<b>F10 (M5b): Observatory</b><br/><font point-size="8.5" color="#f2cc60">Public /chronicle + Rumors<br/>Human vs Bot Telemetry</font>>];
    f11 [fillcolor="#132419", color="#3fb950", label=<<b>F11: Stone &amp; Ironwood</b><br/><font point-size="8.5" color="#7ee787">Tier III/IV Keeps · True Ironwood<br/>Season Archive &amp; Epitaphs</font>>];
    f12 [fillcolor="#211830", color="#bc8cff", penwidth=1.7, label=<<b>F12: Chronicle I + GA</b><br/><font point-size="8.5" color="#d2a8ff">Live VPS Launch + Ready<br/>for SamVM / SamGenAI!</font>>];

    f1 -> f2 -> f3 -> f4 -> f5 -> f6;
    f6 -> f7 -> f10;
    f6 -> f8 -> f12;
    f6 -> f9 -> f10;
    f5 -> f11 -> f12;
    f10 -> f12;
}
