digraph SystemArchitecture {
    graph [
        rankdir=TB,
        bgcolor="#0f1419",
        fontname="Liberation Sans",
        fontsize=15,
        fontcolor="#e6edf3",
        label=<<b>Ironwood Wilds — Modular Monorepo &amp; Hexagonal Server Architecture</b><br/><font point-size="11" color="#8b949e">Pure Java 25 LTS (kotharworks) · Integer-Only Deterministic Core + Virtual-Thread REST/SSE Host</font>>,
        labelloc=t,
        pad="0.45",
        nodesep="0.45",
        ranksep="0.65",
        splines=true
    ];

    node [
        shape=box,
        style="rounded,filled",
        fontname="Liberation Sans",
        fontsize=11,
        fillcolor="#161b22",
        color="#30363d",
        fontcolor="#e6edf3",
        margin="0.16,0.10"
    ];

    edge [
        fontname="Liberation Sans",
        fontsize=9,
        color="#6e7681",
        fontcolor="#8b949e",
        penwidth=1.3,
        arrowsize=0.75
    ];

    subgraph cluster_clients {
        label=<<b>Clients, CLI Rigs &amp; Agent Harnesses</b>>;
        fontcolor="#d29922";
        color="#3d3216";
        bgcolor="#14181f";
        style="rounded,dashed,filled";

        human_browser [
            fillcolor="#1f2937",
            color="#d29922",
            label=<<b>Human Web Browser (/play)</b><br/><font point-size="9" color="#9ca3af">SSR Multi-Tab Deck + Personas/Journals<br/>SSE Push + Local 60fps Timers</font>>
        ];
        rest_sse_bot [
            fillcolor="#1f2937",
            color="#58a6ff",
            label=<<b>apps/wilds-bot &amp; External Bots</b><br/><font point-size="9" color="#9ca3af">GET /api/v1/rules + Doctrine Seam<br/>POST /api/v1/commands (cmdId) + SSE</font>>
        ];
        headless_cli [
            fillcolor="#1c261e",
            color="#3fb950",
            label=<<b>apps/wilds-headless (M0 Rig)</b><br/><font point-size="9" color="#7ee787">Fast-Forward Runs · WAL Replay + WorldHash<br/>ASCII Biome/Site Map Gallery</font>>
        ];
        ga_arena [
            fillcolor="#281c33",
            color="#bc8cff",
            label=<<b>apps/wilds-arena (Phase 2 GA)</b><br/><font point-size="9" color="#d2a8ff">libs/samvm + libs/samgenai<br/>10,000x Headless Evolution</font>>
        ];
    }

    subgraph cluster_server {
        label=<<b>apps/wilds-server</b>  <font point-size="10" color="#8b949e">(Hexagonal Host · Java 25 Virtual Threads)</font>>;
        fontcolor="#58a6ff";
        color="#1f3a5f";
        bgcolor="#121923";
        style="rounded,filled";

        subgraph cluster_inbound {
            label=<Inbound HTTP Adapters (JDK HttpServer)>;
            fontcolor="#8b949e";
            fontsize=10;
            color="#263345";
            bgcolor="#16202d";
            style="rounded,filled";

            http_ui [label=<<b>SSR HTML Adapter</b><br/><font point-size="9" color="#8b949e">Html Builder + ~250 LOC JS</font>>];
            http_rest [label=<<b>REST &amp; Commands</b><br/><font point-size="9" color="#8b949e">/api/v1/* + POST /commands</font>>];
            sse_adapter [label=<<b>SSE Stream Adapter</b><br/><font point-size="9" color="#8b949e">/api/v1/stream?since=cursor</font>>];
        }

        auth_guard [
            fillcolor="#1b2738",
            color="#388bfd",
            label=<<b>libs/auth + WildsAuthorizer + Rate Guard</b><br/><font point-size="9" color="#9ca3af">OIDC JWT (Keycloak / Dev-Local) or Scoped iw_bot_ Key<br/>-&gt; Principal(UserId, Roles) -&gt; Authorized HouseholdId</font>>
        ];

        mailbox [
            fillcolor="#241e14",
            color="#d29922",
            penwidth=1.8,
            label=<<b>WorldHost (Single-Writer Mailbox + 1 Hz Pump)</b><br/><font point-size="9" color="#e3b341">Synchronous cmdId Validation · PAUSE_WHILE_DOWN · Lock-Free WorldView</font>>
        ];

        persist_port [
            fillcolor="#1b2738",
            color="#388bfd",
            label=<<b>WorldStorePort &amp; EventBusPort</b><br/><font point-size="9" color="#9ca3af">Command WAL (Truth) + Tick-Boundary Snapshots + Fogged Rumors</font>>
        ];
    }

    subgraph cluster_wilds {
        label=<<b>libs/wilds</b>  <font point-size="10" color="#3fb950">(100% Pure Deterministic Simulation Core · Zero I/O · Zero Floats · Zero Wall-Clock)</font>>;
        fontcolor="#3fb950";
        color="#1f4729";
        bgcolor="#101b14";
        style="rounded,filled";

        engine_facade [
            fillcolor="#172b1e",
            color="#3fb950",
            penwidth=1.8,
            label=<<b>WildsEngine Facade</b><br/><font point-size="9" color="#7ee787">apply(WorldCommand) · advanceTo(ms) · advanceToNextEvent() · worldHash()</font>>
        ];

        world_state [
            fillcolor="#16241a",
            color="#2ea043",
            label=<<b>Dense EntityTables (index, gen)</b><br/><font point-size="9" color="#9ca3af">Households · Characters (+Personas)<br/>Holds · Buildings · Parties · SiteDeltas</font>>
        ];

        due_heap [
            fillcolor="#16241a",
            color="#2ea043",
            label=<<b>Integer LazyGauge + DueEventHeap</b><br/><font point-size="9" color="#9ca3af">Min-Heap (dueAtMs, seq)<br/>O(1) Idle · heapTicket Cancel</font>>
        ];

        strategies [
            fillcolor="#16241a",
            color="#2ea043",
            label=<<b>Strategies &amp; Compile-Time Rules</b><br/><font point-size="9" color="#9ca3af">ActionMechanic&lt;P&gt; · 3-Ring RaidResolver<br/>PvM ExpeditionResolver · TitheShipSystem</font>>
        ];
    }

    subgraph cluster_bottom {
        label="";
        style=invis;

        procgen [
            fillcolor="#1c2128",
            color="#f0883e",
            penwidth=1.6,
            label=<<b>libs/procgen (Zero Runtime Deps, Zero I/O)</b><br/><font point-size="9" color="#ffa657">WorldSeed Streams · Region Passes &amp; Waypoints · MythFlags<br/>NameGrammar · Persona &amp; JournalComposer · glance/look/examine Prose</font>>
        ];

        postgres [
            shape=cylinder,
            fillcolor="#1a2230",
            color="#58a6ff",
            penwidth=1.6,
            label=<<b>PostgreSQL (JDBI + ~100 LOC Migrator)</b><br/><font point-size="9" color="#79c0ff">Schema 1: auth (Users UUID, OIDC Links, Bot Keys — 0 Passwords)<br/>Schema 2: wilds_meta (Houses by UserId, Replay Triple, Legacy)<br/>Schema 3: wilds_world (command_wal Truth + Snapshots)</font>>
        ];
    }

    human_browser -> http_ui [color="#d29922"];
    human_browser -> http_rest [color="#d29922"];
    human_browser -> sse_adapter [color="#d29922"];
    rest_sse_bot -> http_rest [color="#58a6ff"];
    rest_sse_bot -> sse_adapter [color="#58a6ff"];

    http_ui -> auth_guard;
    http_rest -> auth_guard;
    sse_adapter -> auth_guard;

    auth_guard -> mailbox [label=" CommandSubmission(cmdId)", color="#d29922"];
    auth_guard -> postgres [style=dashed, color="#388bfd"];

    mailbox -> engine_facade [label=" apply() / advanceTo()", color="#3fb950", penwidth=1.8];
    mailbox -> persist_port;
    persist_port -> postgres [color="#58a6ff", penwidth=1.5];

    headless_cli -> engine_facade [label=" Replay &amp; Golden Hash", color="#3fb950", penwidth=1.6, style=dashed];
    ga_arena -> engine_facade [label=" In-Process Rollouts", color="#bc8cff", penwidth=1.8, style=dashed];
    ga_arena -> rest_sse_bot [label=" Champion Doctrine", color="#bc8cff", style=dotted];

    engine_facade -> world_state;
    engine_facade -> due_heap;
    engine_facade -> strategies;

    world_state -> procgen [color="#f0883e"];
    strategies -> procgen [color="#f0883e"];
}
