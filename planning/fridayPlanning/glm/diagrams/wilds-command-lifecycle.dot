// Ironwood Wilds — Command lifecycle: client to world event
// Follows IronwoodWildsCommands.md §3. Green = happy path, red = rejection,
// amber = fail-soft, blue = response/observation.
digraph CommandLifecycle {
    graph [rankdir=TB, bgcolor="#ffffff", pad=0.35,
           fontname="DejaVu Sans", fontsize=15, labelloc=t,
           label=<<b>Ironwood Wilds — Command Lifecycle</b><br/>admission responds immediately · outcomes arrive later as events>];
    node  [fontname="DejaVu Sans", fontsize=10, margin="0.14,0.08"];
    edge  [fontname="DejaVu Sans", fontsize=9, fontcolor="#444444", arrowsize=0.7];

    start [shape=circle, label="", style=filled, fillcolor="#38663f", width=0.22];
    post  [shape=box, style="rounded,filled", fillcolor="#ece7f1", color="#6d5f8a",
           label="client: POST /v1/commands\ncmdId (UUIDv7) · type · payload"];

    auth  [shape=diamond, style=filled, fillcolor="#f5ecd9", color="#b08a3e",
           label="auth + rate\nlimit ok?"];
    e401  [shape=box, style="rounded,filled", fillcolor="#f7ddda", color="#a0453a",
           label="401 / 429"];

    decode [shape=diamond, style=filled, fillcolor="#f5ecd9", color="#b08a3e",
            label="decodes to sealed\nCommand? shape ok?"];
    e400   [shape=box, style="rounded,filled", fillcolor="#f7ddda", color="#a0453a",
            label="400 MALFORMED"];

    idem  [shape=diamond, style=filled, fillcolor="#f5ecd9", color="#b08a3e",
           label="cmdId already\nin log?"];
    prior [shape=box, style="rounded,filled", fillcolor="#e3ecf2", color="#3d6a80",
           label="return original result\n(idempotent, no re-apply)"];

    authority [shape=diamond, style=filled, fillcolor="#f5ecd9", color="#b08a3e",
               label="authority ok?\naccount → household\n→ character alive"];
    e403 [shape=box, style="rounded,filled", fillcolor="#f7ddda", color="#a0453a",
          label="403 FORBIDDEN"];

    cheap [shape=diamond, style=filled, fillcolor="#f5ecd9", color="#b08a3e",
           label="cheap checks?\nqueue cap · known action\nskill / tech gates"];
    e409 [shape=box, style="rounded,filled", fillcolor="#f7ddda", color="#a0453a",
          label="409 QUEUE_FULL · UNKNOWN_*\nSKILL_TOO_LOW · …"];

    commit [shape=box, style="rounded,filled", fillcolor="#e8f0e2", color="#4a7c59",
            label="stamp admittedTick · append command_log\n(DB commit — durability before apply)"];

    ok200  [shape=box, style="rounded,filled", fillcolor="#e3ecf2", color="#3d6a80",
            label="200 admitted\nqueue snapshot + ETAs"];

    mailbox [shape=box, style="rounded,filled", fillcolor="#f0dfb4", color="#8a6d1f",
             label="mailbox → WorldHost\n(single writer)"];

    advance [shape=box, style="rounded,filled", fillcolor="#f0dfb4", color="#8a6d1f",
             label="advanceTo(admittedTick)\npop heap in (dueMs, seq) order"];

    applyc [shape=box, style="rounded,filled", fillcolor="#e8f0e2", color="#4a7c59",
            label="apply command\n(exhaustive switch)"];

    startck [shape=diamond, style=filled, fillcolor="#e8f0e2", color="#4a7c59",
             label="action start-time\nchecks pass?\ninputs · target · slot · reach"];
    failsoft [shape=box, style="rounded,filled", fillcolor="#f8ecd4", color="#a3722a",
              label="ActionFailed{reason} event\nqueue advances (fail-soft)"];

    sched [shape=box, style="rounded,filled", fillcolor="#e8f0e2", color="#4a7c59",
           label="schedule heap entry\n(dueMs = now + duration, seq)"];

    complete [shape=box, style="rounded,filled", fillcolor="#e8f0e2", color="#4a7c59",
              label="completion tick: apply effects atomically\nconsume inputs · grant outputs · award XP"];

    evbuf [shape=box, style="rounded,filled", fillcolor="#dcead8", color="#38663f",
           label="DomainEvent buffer\ndrain after batch"];

    sse   [shape=box, style="rounded,filled", fillcolor="#e3ecf2", color="#3d6a80",
           label="SSE fan-out\naction.completed · xp.gained · …"];
    chron [shape=box, style="rounded,filled", fillcolor="#e3ecf2", color="#3d6a80",
           label="chronicle rows\n(public wire)"];

    client_sees [shape=box, style="rounded,filled", fillcolor="#ece7f1", color="#6d5f8a",
                 label="client observes:\nSSE stream · GET /v1/events?since=cursor"];

    start -> post;
    post -> auth;
    auth -> e401 [color="#a0453a"]; auth -> decode [color="#4a7c59", label="yes"];
    decode -> e400 [color="#a0453a"]; decode -> idem [color="#4a7c59", label="yes"];
    idem -> prior [color="#3d6a80", label="yes"]; idem -> authority [color="#4a7c59", label="no"];
    authority -> e403 [color="#a0453a"]; authority -> cheap [color="#4a7c59", label="yes"];
    cheap -> e409 [color="#a0453a"]; cheap -> commit [color="#4a7c59", label="yes"];
    commit -> ok200 [color="#3d6a80", label="respond now"];
    commit -> mailbox [color="#8a6d1f"];
    mailbox -> advance -> applyc -> startck;
    startck -> failsoft [color="#a3722a", label="no"];
    startck -> sched [color="#4a7c59", label="yes"];
    sched -> complete [color="#4a7c59", label="… ticks pass (lazy / 1 Hz pump)"];
    failsoft -> evbuf [color="#a3722a"];
    complete -> evbuf [color="#4a7c59"];
    evbuf -> sse [color="#3d6a80"]; evbuf -> chron [color="#3d6a80"];
    sse -> client_sees [color="#3d6a80"];
}
