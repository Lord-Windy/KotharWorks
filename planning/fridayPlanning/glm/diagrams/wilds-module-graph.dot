// Ironwood Wilds — Monorepo module graph
// Solid arrows = compile-time dependencies. Dashed = runtime-only relationships.
strict digraph ModuleGraph {
    graph [rankdir=TB, bgcolor="#ffffff", pad=0.35, compound=true,
           fontname="DejaVu Sans", fontsize=15,
           labelloc=t,
           label=<<b>Ironwood Wilds — Monorepo Module Graph</b><br/>solid = compile-time dependency · dashed = runtime relationship>];
    node  [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=11,
           margin="0.18,0.10"];
    edge  [color="#6b6b6b", arrowsize=0.75, fontname="DejaVu Sans", fontsize=9,
           fontcolor="#444444"];

    subgraph cluster_clients {
        label="clients (any language, out of repo)";
        labelloc=b;
        style="rounded,filled"; fillcolor="#f6f4f8"; color="#8a7fa8";
        browser  [label="web browser\nserver-rendered HTML + SSE", fillcolor="#ece7f1", color="#6d5f8a"];
        bots     [label="bots · future GA brains\nREST + SSE", fillcolor="#ece7f1", color="#6d5f8a"];
        spectate [label="spectators\npublic read-only API", fillcolor="#ece7f1", color="#6d5f8a"];
    }

    subgraph cluster_apps {
        label="apps/ — hexagonal hosts (I/O lives here)";
        style="rounded,filled"; fillcolor="#faf6ec"; color="#b08a3e";
        server   [label=<<b>apps/wilds-server</b><br/>HTTP · SSE · HTML · auth · JDBI · clock pump>, fillcolor="#f5ecd9", color="#b08a3e"];
        headless [label=<<b>apps/wilds-headless</b><br/>run · replay · hash · gallery>, fillcolor="#f5ecd9", color="#b08a3e"];
        bot      [label=<<b>apps/wilds-bot</b><br/>reference player · Doctrine seam>, fillcolor="#f5ecd9", color="#b08a3e"];
    }

    subgraph cluster_libs {
        label="libs/ — pure, deterministic, zero I/O";
        style="rounded,filled"; fillcolor="#f2f7f0"; color="#4a7c59";
        procgen [label=<<b>libs/procgen</b><br/>WorldSeed · RngDraws · Noise<br/>PoissonDisc · NameGrammar>, fillcolor="#e8f0e2", color="#4a7c59"];
        wilds   [label=<<b>libs/wilds</b><br/>event heap · tables · commands · actions<br/>rules · world · pvm · hold · obs · replay>, fillcolor="#e8f0e2", color="#4a7c59"];
        procgen -> wilds;
    }

    pg [label="PostgreSQL\nschema auth · schema wilds_meta", shape=cylinder,
        style="filled", fillcolor="#f7e6e2", color="#a05a4a"];

    wilds   -> server;
    wilds   -> headless;
    browser -> server [style=dashed, color="#8a7fa8", label="HTTPS"];
    bots    -> server [style=dashed, color="#8a7fa8", label="HTTPS"];
    spectate-> server [style=dashed, color="#8a7fa8", label="HTTPS"];
    bot     -> server [style=dashed, color="#8a7fa8", label="HTTPS — no code dep"];
    server  -> pg     [style=dashed, color="#a05a4a", label="JDBI"];
    headless-> pg     [style=dashed, color="#a05a4a", label="log export / replay"];
}
