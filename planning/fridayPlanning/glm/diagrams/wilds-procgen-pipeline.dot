// Ironwood Wilds — Procedural generation pipeline
// Follows IronwoodWildsProcgen.md §2-§7. Everything derives from one season
// seed through named positional streams; regions materialise lazily.
digraph ProcgenPipeline {
    graph [rankdir=TB, bgcolor="#ffffff", pad=0.35,
           fontname="DejaVu Sans", fontsize=15, labelloc=t,
           label=<<b>Ironwood Wilds — Procedural Generation Pipeline</b><br/>one season seed · named positional streams · lazy region materialisation>];
    node  [fontname="DejaVu Sans", fontsize=10, margin="0.15,0.08"];
    edge  [color="#6b6b6b", arrowsize=0.7, fontname="DejaVu Sans", fontsize=9,
           fontcolor="#444444"];

    seed [shape=box, style="rounded,filled", fillcolor="#dcead8", color="#38663f",
          label=<<b>season seed</b> (64-bit)>];
    streams [shape=box, style="rounded,filled", fillcolor="#e8f0e2", color="#4a7c59",
             label=<<b>RngDraws — named positional streams</b><br/>stream("terrain", x, y) · stream("deposits", x, y) · …<br/>order-independent: any region, any order, same result>];
    seed -> streams;

    subgraph cluster_region {
        label="per region — lazy, on first contact (the fog is ungenerated data)";
        style="rounded,filled"; fillcolor="#f2f7f0"; color="#4a7c59";
        p1 [label="1 · elevation\nfBm simplex + domain warp", fillcolor="#e8f0e2", color="#4a7c59"];
        p2 [label="2 · hydrology\nflow accumulation, lakes, fords", fillcolor="#e8f0e2", color="#4a7c59"];
        p3 [label="3 · climate\ntemp · moisture · rain shadow", fillcolor="#e8f0e2", color="#4a7c59"];
        p4 [label="4 · biomes\nWhittaker lookup → 12 archetypes", fillcolor="#e8f0e2", color="#4a7c59"];
        p5 [label="5 · deposits\nPoisson-disc + richness bands", fillcolor="#e8f0e2", color="#4a7c59"];
        p6 [label="6 · sites\nruins · springs · watchtowers", fillcolor="#e8f0e2", color="#4a7c59"];
        p7 [label="7 · lairs\ndanger gradient from landings", fillcolor="#e8f0e2", color="#4a7c59"];
        p1 -> p2 -> p3 -> p4 -> p5 -> p6 -> p7;
    }

    streams -> p1 [lhead=cluster_region, label="WorldSeed.regionHash(x,y)"];

    subgraph cluster_demand {
        label="on demand — first contact during play";
        style="rounded,filled"; fillcolor="#f2f7f0"; color="#4a7c59";
        p8 [label="8 · names\nphonotactic grammar, dedup trie\n(minted on contact — play-order-stable)", fillcolor="#e8f0e2", color="#4a7c59"];
        p9 [label="9 · descriptions\nslot/template: look → examine → facet\n(derived views, never stored)", fillcolor="#e8f0e2", color="#4a7c59"];
    }

    subgraph cluster_start {
        label="season start — once";
        style="rounded,filled"; fillcolor="#f2f7f0"; color="#4a7c59";
        p10 [label="10 · season myth\n3-5 world facts: rival landing,\nsignature atrocity, final-raid flavour", fillcolor="#e8f0e2", color="#4a7c59"];
    }

    streams -> p10 [lhead=cluster_start];
    p7 -> p8 [lhead=cluster_demand, style=dashed];
    p6 -> p9 [lhead=cluster_demand, style=dashed];

    regionstate [shape=box, style="rounded,filled", fillcolor="#e3ecf2", color="#3d6a80",
                 label=<<b>RegionState</b> — cached in WorldState, persisted in snapshots<br/>depletion/regen live in world tables, seeds stay pristine>];
    p7 -> regionstate;

    consumers [shape=box, style="rounded,filled", fillcolor="#ece7f1", color="#6d5f8a",
               label="consumers: atlas views · travel costs · site look/examine text\nrumor events · lair flavour · season almanac"];
    regionstate -> consumers [style=dashed];
    p8 -> consumers [style=dashed];
    p9 -> consumers [style=dashed];
    p10 -> consumers [style=dashed, label="myth flags dress\nrumors · raids · chronicle"];
}
