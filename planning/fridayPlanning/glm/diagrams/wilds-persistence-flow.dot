// Ironwood Wilds — Persistence & recovery flows
// Follows IronwoodWildsPersistence.md. The command log is the source of
// truth; snapshots are cache; chronicle/favor are rebuildable projections.
digraph PersistenceFlow {
    graph [rankdir=LR, bgcolor="#ffffff", pad=0.35,
           fontname="DejaVu Sans", fontsize=15, labelloc=t,
           label=<<b>Ironwood Wilds — Persistence &amp; Recovery</b><br/>truth = seed + rules + command log · snapshots are cache · projections rebuild>];
    node  [fontname="DejaVu Sans", fontsize=10, margin="0.15,0.08"];
    edge  [fontname="DejaVu Sans", fontsize=9, fontcolor="#444444", arrowsize=0.7];

    adm [shape=box, style="rounded,filled", fillcolor="#f0dfb4", color="#8a6d1f",
         label=<<b>Admissions</b><br/>stamp tick · seq>];
    host [shape=box, style="rounded,filled", fillcolor="#f0dfb4", color="#8a6d1f",
          label=<<b>WorldHost</b><br/>single writer · engine owns>];

    cmdlog [shape=cylinder, style=filled, fillcolor="#dcead8", color="#38663f",
            label=<<b>command_log</b><br/>TRUTH — append-only<br/>(season, seq, tick, cmd_id, payload)>];
    snaps  [shape=cylinder, style=filled, fillcolor="#f8ecd4", color="#a3722a",
            label=<<b>snapshots</b><br/>CACHE — tick boundaries only<br/>(tick, up_to_seq, world jsonb)>];
    chron  [shape=cylinder, style=filled, fillcolor="#e3ecf2", color="#3d6a80",
            label=<<b>chronicle_events<br/>favor_ledger</b><br/>PROJECTIONS — idempotent upserts>];

    adm -> cmdlog [color="#38663f", label="commit before apply"];
    adm -> host [color="#8a6d1f", label="mailbox"];
    host -> chron [color="#3d6a80", label="DomainEvents →\nasync batch (VT)"];
    host -> snaps [color="#a3722a", label="every 10 min +\ngraceful shutdown"];

    subgraph cluster_recovery {
        label="crash recovery (kill -9 safe)";
        style="rounded,filled"; fillcolor="#faf6ec"; color="#b08a3e";
        load [shape=box, style="rounded,filled", fillcolor="#f5ecd9", color="#b08a3e",
              label="load latest snapshot\n(clean tick boundary)"];
        tail [shape=box, style="rounded,filled", fillcolor="#f5ecd9", color="#b08a3e",
              label="replay command_log\nwhere seq > up_to_seq\n(same engine, fast-forward)"];
        resume [shape=box, style="rounded,filled", fillcolor="#e8f0e2", color="#4a7c59",
                label="resume WorldHost\nhash unchanged — proven in slice M3"];
        load -> tail -> resume;
    }

    snaps -> load [style=dashed, color="#a3722a", label="on boot"];
    cmdlog -> tail [style=dashed, color="#a3722a"];

    replaytool [shape=box, style="rounded,filled", fillcolor="#ece7f1", color="#6d5f8a",
                label="apps/wilds-headless replay\n--season N --to tick → world hash\n(debug · A/B worlds · GA fitness)"];
    cmdlog -> replaytool [style=dashed, color="#6d5f8a"];
    snaps -> replaytool [style=dashed, color="#6d5f8a", label="or from zero —\nlog is truth"];

    archive [shape=box, style="rounded,filled", fillcolor="#f7e6e2", color="#a05a4a",
             label="season archive\nfinal snapshot + log + chronicle export\n+ legacy rows → cold storage"];
    host -> archive [color="#a05a4a", label="season end"];
}
