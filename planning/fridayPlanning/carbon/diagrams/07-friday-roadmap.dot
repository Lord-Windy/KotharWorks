digraph FridayRoadmap {
    graph [
        rankdir=LR,
        bgcolor="#0f1419",
        fontname="Liberation Sans",
        fontsize=14,
        fontcolor="#e6edf3",
        label=<<b>12-Friday Execution DAG — From Scaffold to Live Simulation &amp; GA Lab</b><br/><font point-size="11" color="#8b949e">Every Friday ends with mvnd test green (0 warnings) and a concrete demoable milestone</font>>,
        labelloc=t,
        pad="0.38",
        nodesep="0.38",
        ranksep="0.55"
    ];

    node [
        shape=box,
        style="rounded,filled",
        fontname="Liberation Sans",
        fontsize=10,
        fillcolor="#161b22",
        color="#30363d",
        fontcolor="#e6edf3",
        margin="0.13,0.09"
    ];

    edge [
        color="#6e7681",
        penwidth=1.3,
        arrowsize=0.72
    ];

    f1 [fillcolor="#261d14", color="#f0883e", label=<<b>F1: libs/procgen</b><br/><font point-size="8.5" color="#ffa657">WorldSeed · Frontier Graph<br/>glance/look/examine Prose</font>>];
    f2 [fillcolor="#132419", color="#3fb950", label=<<b>F2: Sim Kernel</b><br/><font point-size="8.5" color="#7ee787">LazyGauge · DueEventHeap<br/>WorldState + RuleRegistry</font>>];
    f3 [fillcolor="#132419", color="#3fb950", label=<<b>F3: Actions &amp; XP</b><br/><font point-size="8.5" color="#7ee787">ActionMechanic&lt;P&gt; · 2-Phase<br/>Fail-Soft Queues · Skills</font>>];
    f4 [fillcolor="#132419", color="#3fb950", label=<<b>F4: Raids &amp; PvM</b><br/><font point-size="8.5" color="#7ee787">Non-Lethal Hold Raids<br/>Lethal Party Delves · Supply</font>>];

    f5 [fillcolor="#142030", color="#58a6ff", label=<<b>F5: Server &amp; Wire</b><br/><font point-size="8.5" color="#79c0ff">Single-Writer Mailbox<br/>REST /api/v1 + TCP :8124</font>>];
    f6 [fillcolor="#261f12", color="#d29922", label=<<b>F6: Char Tabs UI</b><br/><font point-size="8.5" color="#f2cc60">SSR Multi-Tab Deck (1..9)<br/>60fps Client Lazy Timers + WS</font>>];
    f7 [fillcolor="#261f12", color="#d29922", label=<<b>F7: Macro Tabs UI</b><br/><font point-size="8.5" color="#f2cc60">3-Ring Hold &amp; Raid Matrix<br/>Party Gambits &amp; Chronicles</font>>];
    f8 [fillcolor="#142030", color="#58a6ff", label=<<b>F8: Postgres 3-Schema</b><br/><font point-size="8.5" color="#79c0ff">auth · wilds_meta · wilds_world<br/>WAL + Checkpoints + Bot Keys</font>>];

    f9 [fillcolor="#142030", color="#58a6ff", label=<<b>F9: apps/wilds-bot</b><br/><font point-size="8.5" color="#79c0ff">Reference Bot over :8124<br/>10-Bot Headless Soak CI</font>>];
    f10 [fillcolor="#261f12", color="#d29922", label=<<b>F10: Observatory</b><br/><font point-size="8.5" color="#f2cc60">Public /chronicle SVG Map<br/>Human vs Bot Telemetry</font>>];
    f11 [fillcolor="#132419", color="#3fb950", label=<<b>F11: Tier III/IV Depth</b><br/><font point-size="8.5" color="#7ee787">Stone Keeps · Steel Chain<br/>4 Biomes · Chronicle Wipe CLI</font>>];
    f12 [fillcolor="#211830", color="#bc8cff", penwidth=1.7, label=<<b>F12: Live Launch + GA</b><br/><font point-size="8.5" color="#d2a8ff">ironwoodwilds VPS Chronicle I<br/>Ready for SamVM / SamGenAI!</font>>];

    f1 -> f2 -> f3 -> f4 -> f5;
    f5 -> f6 -> f7 -> f10;
    f5 -> f8 -> f12;
    f5 -> f9 -> f10;
    f4 -> f11 -> f12;
    f10 -> f12;
}
