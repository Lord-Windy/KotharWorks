digraph ProcgenPipeline {
    graph [
        rankdir=TB,
        bgcolor="#0f1419",
        fontname="Liberation Sans",
        fontsize=14,
        fontcolor="#e6edf3",
        label=<<b>libs/procgen — Order-Independent World, Lair &amp; Prose Generation</b><br/><font point-size="11" color="#8b949e">Zero LLMs · Zero External Runtime Dependencies · 100% Deterministic from 64-bit WorldSeed</font>>,
        labelloc=t,
        pad="0.40",
        nodesep="0.42",
        ranksep="0.58"
    ];

    node [
        shape=box,
        style="rounded,filled",
        fontname="Liberation Sans",
        fontsize=10.5,
        fillcolor="#161b22",
        color="#30363d",
        fontcolor="#e6edf3",
        margin="0.15,0.10"
    ];

    edge [
        fontname="Liberation Sans",
        fontsize=9,
        color="#8b949e",
        fontcolor="#9ca3af",
        penwidth=1.3,
        arrowsize=0.75
    ];

    seed [
        fillcolor="#2b2013",
        color="#f0883e",
        penwidth=1.8,
        label=<<b>WorldSeed(long value)</b><br/><font point-size="9" color="#ffa657">rngFor(domainSalt, coordA, coordB) -&gt; Isolated SplitMix64 Stream<br/>Visitation-Order Independent (Unvisited continent uses 0 RAM!)</font>>
    ];

    subgraph cluster_macro {
        label=<<b>Scale 1: Macro Geography &amp; Ecology</b>>;
        fontcolor="#3fb950";
        color="#1f4729";
        bgcolor="#101a14";
        style="rounded,filled";

        fields [label=<<b>Frontier Envelope + Simplex Fields</b><br/><font point-size="9" color="#9ca3af">frontierDepth (0.0 Coast -&gt; 1.0 Deep Wilds)<br/>elevation · ruggedness · moisture · chill</font>>];
        biomes [label=<<b>Geological &amp; Biome Coupling</b><br/><font point-size="9" color="#7ee787">Shelterwood (T0) -&gt; Peat Fen (Bog-Iron)<br/>-&gt; Crags (Hematite) -&gt; Heart-Ironwood (T4)</font>>];
        graph_map [label=<<b>Waypoint Region &amp; Site Graph</b><br/><font point-size="9" color="#9ca3af">Sovereign Hold Clearings + Travel Edges<br/>(Real logistics distance without A* tile grid)</font>>];
    }

    subgraph cluster_meso {
        label=<<b>Scale 2: Meso PvM Lair Grammar</b>>;
        fontcolor="#f85149";
        color="#4d1f24";
        bgcolor="#1a1214";
        style="rounded,filled";

        lair_dag [label=<<b>Directed Room DAG Generator</b><br/><font point-size="9" color="#ffa198">Approach Check -&gt; Outer Pack<br/>-&gt; Optional Skill Shortcut (Mining/Lore)<br/>-&gt; Alpha Chamber &amp; Relic Salvage</font>>];
    }

    subgraph cluster_micro {
        label=<<b>Scale 3: Micro Prose Composer (procgen_mvp Evolved)</b>>;
        fontcolor="#58a6ff";
        color="#1f3a5f";
        bgcolor="#121924";
        style="rounded,filled";

        catalog [label=<<b>Static ProseCatalog (Classpath)</b><br/><font point-size="9" color="#9ca3af">Categories · Recursive Slots · Pick-List Tables<br/>Explicit singular/plural · Wear Surfaces</font>>];
        live_ctx [label=<<b>Dynamic ProseContext (libs/wilds)</b><br/><font point-size="9" color="#79c0ff">conditionPct (Pristine / Raid-Battered)<br/>Season · Weather · Active Worker Name</font>>];
        zoom_out [label=<<b>3 Deterministic Zoom Levels</b><br/><font point-size="9" color="#e6edf3">• <b>glance</b>: Compact tab/tooltip label<br/>• <b>look</b>: 1–2 sentence location banner<br/>• <b>examine</b>: Deep Dwarf-Fortress inspection</font>>];
    }

    seed -> fields [label=" domain='geo'", color="#f0883e"];
    seed -> lair_dag [label=" domain='lair'", color="#f0883e"];
    seed -> zoom_out [label=" domain='prose'", color="#f0883e"];

    fields -> biomes -> graph_map [color="#3fb950"];
    biomes -> lair_dag [label=" Biome Threat &amp; Foes", style=dashed, color="#f85149"];

    catalog -> zoom_out [color="#58a6ff"];
    live_ctx -> zoom_out [color="#58a6ff"];
}
