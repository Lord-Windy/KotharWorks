digraph EntitySchemaAndPatterns {
    graph [
        rankdir=LR,
        bgcolor="#0f1419",
        fontname="Liberation Sans",
        fontsize=15,
        fontcolor="#e6edf3",
        label=<<b>Data-Oriented Entity Schema + Classic GoF Design Patterns in Java 25</b><br/><font point-size="11" color="#8b949e">Entities hold ONLY typed value IDs (zero object-pointer cycles); GoF patterns drive behavior &amp; extensibility</font>>,
        labelloc=t,
        pad="0.40",
        nodesep="0.40",
        ranksep="0.85"
    ];

    node [
        shape=plain,
        fontname="Liberation Sans",
        fontsize=10,
        fontcolor="#e6edf3"
    ];

    edge [
        fontname="Liberation Mono",
        fontsize=8.5,
        color="#6e7681",
        fontcolor="#8b949e",
        penwidth=1.2,
        arrowsize=0.75
    ];

    // ── LEFT: GOF BEHAVIOR & EXTENSIBILITY PATTERNS ─────────────────────────
    subgraph cluster_gof {
        label=<<b>1. GoF Behavior &amp; Rule Seams (Stateless / Immutable)</b>>;
        fontcolor="#d29922";
        color="#4a3919";
        bgcolor="#151921";
        style="rounded,filled";

        cmd_pattern [label=<
            <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#1f242d" COLOR="#d29922">
                <TR><TD BGCOLOR="#2d2312" ALIGN="LEFT"><B><FONT COLOR="#f2cc60">«Command Pattern» sealed WorldCommand</FONT></B></TD></TR>
                <TR><TD ALIGN="LEFT">• EnqueueAction(HouseholdId, CharacterId, ActionSpec)</TD></TR>
                <TR><TD ALIGN="LEFT">• ReplaceQueue / CancelActiveAction</TD></TR>
                <TR><TD ALIGN="LEFT">• StartBuilding(HouseholdId, HoldId, RuleId)</TD></TR>
                <TR><TD ALIGN="LEFT">• UpdateHoldDoctrine / FormParty / RecruitSettler</TD></TR>
                <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#8b949e">Exhaustive Java 25 switch + 1:1 WAL JSON journal</FONT></TD></TR>
            </TABLE>
        >];

        strategy_pattern [label=<
            <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#1f242d" COLOR="#58a6ff">
                <TR><TD BGCOLOR="#15263d" ALIGN="LEFT"><B><FONT COLOR="#79c0ff">«Strategy Pattern» Plug-in Mechanics</FONT></B></TD></TR>
                <TR><TD ALIGN="LEFT">• ActionMechanic&lt;P&gt;: validateEnqueue / planStart / onComplete</TD></TR>
                <TR><TD ALIGN="LEFT">• RaidResolutionStrategy (Non-lethal, Vault-aware)</TD></TR>
                <TR><TD ALIGN="LEFT">• CombatResolutionStrategy (Lethal PvM Gambit Engine)</TD></TR>
                <TR><TD ALIGN="LEFT">• SkillFormulaStrategy (XP curves &amp; speed multipliers)</TD></TR>
            </TABLE>
        >];

        prototype_pattern [label=<
            <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#1f242d" COLOR="#bc8cff">
                <TR><TD BGCOLOR="#261936" ALIGN="LEFT"><B><FONT COLOR="#d2a8ff">«Prototype / Flyweight» RuleRegistry</FONT></B></TD></TR>
                <TR><TD ALIGN="LEFT">• ItemDef · SkillDef · RecipeDef (keyed by RuleId)</TD></TR>
                <TR><TD ALIGN="LEFT">• BuildingDef (ring, buildCost, workMs, effects)</TD></TR>
                <TR><TD ALIGN="LEFT">• TechNodeDef (tier, prereqs, sampleCost)</TD></TR>
                <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#8b949e">Loaded once at boot · Served verbatim at GET /api/v1/rules</FONT></TD></TR>
            </TABLE>
        >];
    }

    // ── CENTER: FLAT ENTITY SCHEMA TABLES ───────────────────────────────────
    subgraph cluster_tables {
        label=<<b>2. WorldState Flat Entity Schema (Indexed Maps of Immutable Java 25 Records)</b>>;
        fontcolor="#3fb950";
        color="#1f4729";
        bgcolor="#101914";
        style="rounded,filled";

        household_tbl [label=<
            <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#16221b" COLOR="#2ea043">
                <TR><TD BGCOLOR="#1b3624" ALIGN="LEFT"><B><FONT COLOR="#7ee787">HouseholdRow</FONT></B></TD></TR>
                <TR><TD ALIGN="LEFT"><FONT FACE="Liberation Mono">PK HouseholdId id</FONT></TD></TR>
                <TR><TD ALIGN="LEFT"><FONT FACE="Liberation Mono">FK HoldId primaryHoldId</FONT></TD></TR>
                <TR><TD ALIGN="LEFT"><FONT FACE="Liberation Mono">Set&lt;RuleId&gt; unlockedTechs</FONT></TD></TR>
                <TR><TD ALIGN="LEFT"><FONT FACE="Liberation Mono">Set&lt;SiteId&gt; scoutedSites</FONT></TD></TR>
                <TR><TD ALIGN="LEFT"><FONT FACE="Liberation Mono">long supplyFavorBalance</FONT></TD></TR>
            </TABLE>
        >];

        char_tbl [label=<
            <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#16221b" COLOR="#2ea043">
                <TR><TD BGCOLOR="#1b3624" ALIGN="LEFT"><B><FONT COLOR="#7ee787">CharacterRow</FONT></B></TD></TR>
                <TR><TD ALIGN="LEFT"><FONT FACE="Liberation Mono">PK CharacterId id</FONT></TD></TR>
                <TR><TD ALIGN="LEFT"><FONT FACE="Liberation Mono">FK HouseholdId householdId</FONT></TD></TR>
                <TR><TD ALIGN="LEFT"><FONT FACE="Liberation Mono">LocationRef (HoldId|SiteId|PartyId)</FONT></TD></TR>
                <TR><TD ALIGN="LEFT"><FONT FACE="Liberation Mono">int health · LazyGauge stamina</FONT></TD></TR>
                <TR><TD ALIGN="LEFT"><FONT FACE="Liberation Mono">SkillSheet · EquipmentLoadout</FONT></TD></TR>
                <TR><TD ALIGN="LEFT"><FONT FACE="Liberation Mono">ActiveAction (dueMs, heapTicket)</FONT></TD></TR>
                <TR><TD ALIGN="LEFT"><FONT FACE="Liberation Mono">List&lt;ActionSpec&gt; pendingQueue[0..5]</FONT></TD></TR>
            </TABLE>
        >];

        hold_tbl [label=<
            <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#16221b" COLOR="#2ea043">
                <TR><TD BGCOLOR="#1b3624" ALIGN="LEFT"><B><FONT COLOR="#7ee787">HoldRow &amp; BuildingRow</FONT></B></TD></TR>
                <TR><TD ALIGN="LEFT"><FONT FACE="Liberation Mono">PK HoldId id · FK HouseholdId owner</FONT></TD></TR>
                <TR><TD ALIGN="LEFT"><FONT FACE="Liberation Mono">FK SiteId clearingSiteId</FONT></TD></TR>
                <TR><TD ALIGN="LEFT"><FONT FACE="Liberation Mono">Stockpile baileyStock + int vaultCap</FONT></TD></TR>
                <TR><TD ALIGN="LEFT"><FONT FACE="Liberation Mono">List&lt;BuildingId&gt; -&gt; BuildingRow(RuleId)</FONT></TD></TR>
                <TR><TD ALIGN="LEFT"><FONT FACE="Liberation Mono">HoldDefenseDoctrine · long threat</FONT></TD></TR>
            </TABLE>
        >];

        party_site_tbl [label=<
            <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#16221b" COLOR="#2ea043">
                <TR><TD BGCOLOR="#1b3624" ALIGN="LEFT"><B><FONT COLOR="#7ee787">PartyRow &amp; SiteDeltaRow</FONT></B></TD></TR>
                <TR><TD ALIGN="LEFT"><FONT FACE="Liberation Mono">PK PartyId · List&lt;CharacterId&gt; roster</FONT></TD></TR>
                <TR><TD ALIGN="LEFT"><FONT FACE="Liberation Mono">CombatDoctrine · FK SiteId target</FONT></TD></TR>
                <TR><TD ALIGN="LEFT"><FONT FACE="Liberation Mono">PK SiteId -&gt; LazyGauge seamYields</FONT></TD></TR>
            </TABLE>
        >];
    }

    // ── RIGHT: OBSERVER & PROJECTION ────────────────────────────────────────
    subgraph cluster_out {
        label=<<b>3. Observer &amp; Fog-of-War Read Seam</b>>;
        fontcolor="#f0883e";
        color="#523018";
        bgcolor="#171412";
        style="rounded,filled";

        events_out [label=<
            <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#241c17" COLOR="#f0883e">
                <TR><TD BGCOLOR="#382414" ALIGN="LEFT"><B><FONT COLOR="#ffa657">«Observer» sealed WorldEvent</FONT></B></TD></TR>
                <TR><TD ALIGN="LEFT">• Monotonic cursor (since=410)</TD></TR>
                <TR><TD ALIGN="LEFT">• ActionStarted / Completed / Failed</TD></TR>
                <TR><TD ALIGN="LEFT">• RaidWarning / RaidResolved</TD></TR>
                <TR><TD ALIGN="LEFT">• ExpeditionResolved / SettlerRecruited</TD></TR>
            </TABLE>
        >];

        projector_out [label=<
            <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#241c17" COLOR="#f0883e">
                <TR><TD BGCOLOR="#382414" ALIGN="LEFT"><B><FONT COLOR="#ffa657">ObservationProjector</FONT></B></TD></TR>
                <TR><TD ALIGN="LEFT">• Strips un-scouted sites &amp; rival stocks</TD></TR>
                <TR><TD ALIGN="LEFT">• Evaluates LazyGauges at nowMs</TD></TR>
                <TR><TD ALIGN="LEFT">• Feeds SSR HTML Tabs, WS &amp; GA Inputs</TD></TR>
            </TABLE>
        >];
    }

    // ── RELATIONS ───────────────────────────────────────────────────────────
    cmd_pattern -> strategy_pattern [label="dispatches to", color="#d29922"];
    prototype_pattern -> strategy_pattern [label="parameterizes", color="#bc8cff"];

    strategy_pattern -> household_tbl [color="#58a6ff"];
    strategy_pattern -> char_tbl [color="#58a6ff"];
    strategy_pattern -> hold_tbl [color="#58a6ff"];
    strategy_pattern -> party_site_tbl [color="#58a6ff"];

    char_tbl -> household_tbl [label="householdId", style=dashed, color="#3fb950"];
    hold_tbl -> household_tbl [label="ownerId", style=dashed, color="#3fb950"];
    party_site_tbl -> char_tbl [label="roster IDs", style=dashed, color="#3fb950"];

    household_tbl -> projector_out [color="#f0883e"];
    char_tbl -> projector_out [color="#f0883e"];
    hold_tbl -> events_out [color="#f0883e"];
    char_tbl -> events_out [color="#f0883e"];
}
