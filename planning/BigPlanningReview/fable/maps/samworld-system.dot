// samworld system map — Ironwood Wilds (proposal, Fable, 2026-11-20)
// Style: docs/dot/preferred-flow.md
//
// legend: commands #2563eb solid · views #6b7280 dashed · records #15803d solid
//         identity #b45309 dashed · content #7c3aed dashed · time #be123c solid
//
// render: dot -Tsvg samworld-system.dot -o samworld-system.svg

digraph samworld_system {
    graph [fontname="Helvetica", bgcolor="white", rankdir=LR, compound=true,
           outputorder=edgesfirst, nodesep=0.6, ranksep=1.5]
    node  [fontname="Helvetica", fontsize=12]
    edge  [fontname="Helvetica", fontsize=11, arrowsize=0.8]

    // ------------------------------------------------------------ clients
    subgraph cluster_clients {
        label="Clients"; style="rounded,filled"; fillcolor="#f3f4f6"; color="#d1d5db"

        web [shape=plaintext, label=<
          <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#888888">
            <TR><TD BGCOLOR="#3d4450" COLSPAN="2"><FONT COLOR="#ffffff"><B>Play client</B></FONT></TD></TR>
            <TR><TD PORT="cmd">commands</TD><TD>click · type</TD></TR>
            <TR><TD PORT="render">rendering</TD><TD>views · log text</TD></TR>
            <TR><TD PORT="count">countdown</TD><TD>ends_at − now</TD></TR>
          </TABLE>>]

        bot [shape=plaintext, label=<
          <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#888888">
            <TR><TD BGCOLOR="#3d4450" COLSPAN="2"><FONT COLOR="#ffffff"><B>Bot</B></FONT></TD></TR>
            <TR><TD PORT="policy">policy</TD><TD>greedy-v0 · genome</TD></TR>
            <TR><TD PORT="host">HTTP host</TD><TD>libcurl</TD></TR>
          </TABLE>>]

        watch [shape=plaintext, label=<
          <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#888888">
            <TR><TD BGCOLOR="#3d4450" COLSPAN="2"><FONT COLOR="#ffffff"><B>Observatory</B></FONT></TD></TR>
            <TR><TD PORT="public">public pages</TD><TD>map · ladders · ticker</TD></TR>
          </TABLE>>]
    }

    // --------------------------------------------------------------- edge
    subgraph cluster_edge {
        label="Edge"; style="rounded,filled"; fillcolor="#fef9c3"; color="#e5d98a"

        caddy [shape=plaintext, label=<
          <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#888888">
            <TR><TD BGCOLOR="#3d4450" COLSPAN="2"><FONT COLOR="#ffffff"><B>Caddy</B></FONT></TD></TR>
            <TR><TD PORT="tls">TLS</TD><TD>automatic certs</TD></TR>
            <TR><TD PORT="static">static files</TD><TD>the web client</TD></TR>
            <TR><TD PORT="proxy">reverse proxy</TD><TD>/v1 to loopback</TD></TR>
          </TABLE>>]
    }

    // ------------------------------------------------------------- server
    subgraph cluster_server {
        label="samworld-server · one process"; style="rounded,filled"; fillcolor="#e0f2fe"; color="#a5cfe8"

        transport [shape=plaintext, label=<
          <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#888888">
            <TR><TD BGCOLOR="#3d4450" COLSPAN="2"><FONT COLOR="#ffffff"><B>Transport (engine thread)</B></FONT></TD></TR>
            <TR><TD PORT="http">samhttp</TD><TD>parse · route</TD></TR>
            <TR><TD PORT="auth">auth</TD><TD>token to Family</TD></TR>
            <TR><TD PORT="wire">wire codec</TD><TD>JSON to structs</TD></TR>
          </TABLE>>]

        sim [shape=plaintext, label=<
          <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#888888">
            <TR><TD BGCOLOR="#3d4450" COLSPAN="2"><FONT COLOR="#ffffff"><B>Sim driver (engine thread)</B></FONT></TD></TR>
            <TR><TD PORT="clock">world clock</TD><TD>wall to world ms</TD></TR>
            <TR><TD PORT="submit">submit</TD><TD>advance · check · apply</TD></TR>
            <TR><TD PORT="views">views</TD><TD>fogged per Family</TD></TR>
            <TR><TD PORT="feed">feeds</TD><TD>cursor rings</TD></TR>
            <TR><TD PORT="house">housekeeping</TD><TD>1 Hz · time marks</TD></TR>
          </TABLE>>]

        writer [shape=plaintext, label=<
          <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#888888">
            <TR><TD BGCOLOR="#3d4450" COLSPAN="2"><FONT COLOR="#ffffff"><B>Writer thread</B></FONT></TD></TR>
            <TR><TD PORT="journal">journal batches</TD><TD>group commit</TD></TR>
            <TR><TD PORT="snaps">snapshots</TD><TD>sectioned binary</TD></TR>
            <TR><TD PORT="stats">chronicle rows</TD><TD>per world day</TD></TR>
          </TABLE>>]
    }

    // ------------------------------------------------------------- engine
    subgraph cluster_engine {
        label="Engine libraries · pure: no I/O, no clock, no floats"; style="rounded,filled"; fillcolor="#dcfce7"; color="#a7d9b7"

        samworld [shape=plaintext, label=<
          <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#888888">
            <TR><TD BGCOLOR="#3d4450" COLSPAN="2"><FONT COLOR="#ffffff"><B>samworld</B></FONT></TD></TR>
            <TR><TD PORT="commands">commands</TD><TD>defs + handlers</TD></TR>
            <TR><TD PORT="mechanics">mechanics</TD><TD>gather · craft · travel</TD></TR>
            <TR><TD PORT="state">world state</TD><TD>pools · ids</TD></TR>
            <TR><TD PORT="events">events</TD><TD>bus + rings</TD></TR>
            <TR><TD PORT="rules">rules</TD><TD>built per world</TD></TR>
          </TABLE>>]

        samtime [shape=plaintext, label=<
          <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#888888">
            <TR><TD BGCOLOR="#3d4450" COLSPAN="2"><FONT COLOR="#ffffff"><B>samtime</B></FONT></TD></TR>
            <TR><TD PORT="due">due-queue</TD><TD>(at, seq) heap</TD></TR>
            <TR><TD PORT="flows">flows</TD><TD>value · rate · as_of</TD></TR>
          </TABLE>>]

        pack [shape=plaintext, label=<
          <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#888888">
            <TR><TD BGCOLOR="#3d4450" COLSPAN="2"><FONT COLOR="#ffffff"><B>samironwood (the pack)</B></FONT></TD></TR>
            <TR><TD PORT="defs">defs</TD><TD>items · actions · text</TD></TR>
            <TR><TD PORT="gen">worldgen</TD><TD>regions on demand</TD></TR>
          </TABLE>>]

        procgen [shape=plaintext, label=<
          <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#888888">
            <TR><TD BGCOLOR="#3d4450" COLSPAN="2"><FONT COLOR="#ffffff"><B>samprocgen</B></FONT></TD></TR>
            <TR><TD PORT="tools">toolkit</TD><TD>fields · names · text</TD></TR>
          </TABLE>>]
    }

    // ------------------------------------------------------------ storage
    subgraph cluster_store {
        label="Storage"; style="rounded,filled"; fillcolor="#fae8ff"; color="#dcb8e6"

        pg [shape=plaintext, label=<
          <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#888888">
            <TR><TD BGCOLOR="#3d4450" COLSPAN="2"><FONT COLOR="#ffffff"><B>Postgres</B></FONT></TD></TR>
            <TR><TD PORT="auth">auth</TD><TD>accounts · tokens</TD></TR>
            <TR><TD PORT="world">world</TD><TD>journal · snapshots</TD></TR>
            <TR><TD PORT="chron">chronicle</TD><TD>events · stats · honours</TD></TR>
          </TABLE>>]

        files [shape=plaintext, label=<
          <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#888888">
            <TR><TD BGCOLOR="#3d4450" COLSPAN="2"><FONT COLOR="#ffffff"><B>Files</B></FONT></TD></TR>
            <TR><TD PORT="dir">season directory</TD><TD>tests · lab · export</TD></TR>
          </TABLE>>]
    }

    // ---------------------------------------------------------------- lab
    subgraph cluster_lab {
        label="samworld-lab · no network, no wall clock"; style="rounded,filled"; fillcolor="#ffedd5"; color="#e9c9a0"

        lab [shape=plaintext, label=<
          <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#888888">
            <TR><TD BGCOLOR="#3d4450" COLSPAN="2"><FONT COLOR="#ffffff"><B>Lab driver</B></FONT></TD></TR>
            <TR><TD PORT="run">run · sweep</TD><TD>virtual time</TD></TR>
            <TR><TD PORT="replay">replay · fork</TD><TD>from a journal</TD></TR>
            <TR><TD PORT="metrics">metrics</TD><TD>tables · CSV</TD></TR>
          </TABLE>>]

        policies [shape=plaintext, label=<
          <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#888888">
            <TR><TD BGCOLOR="#3d4450" COLSPAN="2"><FONT COLOR="#ffffff"><B>Policies</B></FONT></TD></TR>
            <TR><TD PORT="decide">decide</TD><TD>view to orders</TD></TR>
            <TR><TD PORT="lgp">genome host</TD><TD>samvm</TD></TR>
          </TABLE>>]

        genai [shape=plaintext, label=<
          <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#888888">
            <TR><TD BGCOLOR="#3d4450" COLSPAN="2"><FONT COLOR="#ffffff"><B>samgenai</B></FONT></TD></TR>
            <TR><TD PORT="evolve">evolve</TD><TD>selection · variation</TD></TR>
          </TABLE>>]
    }

    // Reply-direction flows are declared tail-first with dir=back, so that
    // ranks follow the request path (clients on the left) in any engine.

    // ----------------------------------------------------------- commands
    web:cmd -> caddy:proxy
        [label="POST /v1/commands", class="flow-commands", color="#2563eb", fontcolor="#2563eb"]
    bot:host -> caddy:proxy
        [label="the same API", class="flow-commands", color="#2563eb", fontcolor="#2563eb"]
    caddy:proxy -> transport:http
        [label="HTTP/1.1, loopback", class="flow-commands", color="#2563eb", fontcolor="#2563eb"]
    transport:wire -> sim:submit
        [label="SamWorldCommand", class="flow-commands", color="#2563eb", fontcolor="#2563eb"]
    sim:submit -> samworld:commands
        [label="advance_to · submit", class="flow-commands", color="#2563eb", fontcolor="#2563eb"]
    policies:decide -> lab:run
        [label="orders", class="flow-commands", color="#2563eb", fontcolor="#2563eb"]
    lab:run -> samworld:commands
        [label="in-process submit", class="flow-commands", color="#2563eb", fontcolor="#2563eb"]

    // --------------------------------------------------------------- time
    samworld:mechanics -> samtime:due
        [label="schedule · pop", class="flow-time", color="#be123c", fontcolor="#be123c"]

    // -------------------------------------------------------------- views
    sim:views -> samworld:state
        [label="fogged views", dir=back, class="flow-views", style=dashed, color="#6b7280", fontcolor="#6b7280"]
    sim:feed -> samworld:events
        [label="events", dir=back, class="flow-views", style=dashed, color="#6b7280", fontcolor="#6b7280"]
    transport:wire -> sim:views
        [label="views · events", dir=back, class="flow-views", style=dashed, color="#6b7280", fontcolor="#6b7280"]
    caddy:proxy -> transport:http
        [label="JSON", dir=back, class="flow-views", style=dashed, color="#6b7280", fontcolor="#6b7280"]
    web:render -> caddy:proxy
        [label="views · log text", dir=back, class="flow-views", style=dashed, color="#6b7280", fontcolor="#6b7280"]
    bot:policy -> caddy:proxy
        [label="views · options", dir=back, class="flow-views", style=dashed, color="#6b7280", fontcolor="#6b7280"]
    watch:public -> caddy:static
        [label="pages", dir=back, class="flow-views", style=dashed, color="#6b7280", fontcolor="#6b7280"]
    policies:decide -> samworld:state
        [label="the same views", dir=back, class="flow-views", style=dashed, color="#6b7280", fontcolor="#6b7280"]

    // ------------------------------------------------------------ records
    sim:submit -> writer:journal
        [label="accepted commands", class="flow-records", color="#15803d", fontcolor="#15803d",
         taillabel="per command", labeldistance=2]
    sim:house -> writer:snaps
        [label="snapshot bytes", class="flow-records", color="#15803d", fontcolor="#15803d",
         headlabel="10 min", labeldistance=2]
    sim:house -> writer:stats
        [label="day rows", class="flow-records", color="#15803d", fontcolor="#15803d"]
    writer:journal -> pg:world
        [label="batched insert", class="flow-records", color="#15803d", fontcolor="#15803d",
         headlabel="100 ms", labeldistance=2]
    writer:snaps -> pg:world
        [label="snapshots", class="flow-records", color="#15803d", fontcolor="#15803d"]
    writer:stats -> pg:chron
        [label="rows", class="flow-records", color="#15803d", fontcolor="#15803d"]
    writer:journal -> files:dir
        [label="or files", class="flow-records", color="#15803d", fontcolor="#15803d"]
    lab:replay -> files:dir
        [label="journal · snapshots", dir=back, class="flow-records", color="#15803d", fontcolor="#15803d"]

    // ----------------------------------------------------------- identity
    transport:auth -> pg:auth
        [label="token cache · register", class="flow-identity", style=dashed, color="#b45309", fontcolor="#b45309"]

    // ------------------------------------------------------------ content
    pack:defs -> samworld:rules
        [label="rules builder", class="flow-content", style=dashed, color="#7c3aed", fontcolor="#7c3aed"]
    pack:gen -> samworld:state
        [label="regions", class="flow-content", style=dashed, color="#7c3aed", fontcolor="#7c3aed"]
    procgen:tools -> pack:gen
        [label="fields · names · text", class="flow-content", style=dashed, color="#7c3aed", fontcolor="#7c3aed"]
    genai:evolve -> policies:lgp
        [label="genomes", class="flow-content", style=dashed, color="#7c3aed", fontcolor="#7c3aed"]
}
