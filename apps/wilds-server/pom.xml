<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.kotharworks</groupId>
        <artifactId>kotharworks-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>wilds-server</artifactId>
    <name>KotharWorks :: apps/wilds-server</name>
    <description>Ironwood Wilds online server host: hexagonal WorldHost, SeatAuthorizer, REST &amp; SSE with HikariCP/JDBI3 PostgreSQL persistence, forward SQL migrations and crash recovery</description>

    <dependencies>
        <dependency>
            <groupId>com.kotharworks</groupId>
            <artifactId>wilds</artifactId>
        </dependency>
        <dependency>
            <groupId>com.kotharworks</groupId>
            <artifactId>auth</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>com.zaxxer</groupId>
            <artifactId>HikariCP</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jdbi</groupId>
            <artifactId>jdbi3-core</artifactId>
        </dependency>
        <!-- Resolves the @GuardedBy annotations inside JDBI3/HikariCP class files
             (javac -Werror flags their absence otherwise). Compile-time only. -->
        <dependency>
            <groupId>com.google.errorprone</groupId>
            <artifactId>error_prone_annotations</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- Clean log provider for HikariCP/Testcontainers (runtime only). -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Test-only: cold HeadlessMain WAL replay parity in FullSpineIntegrationTest. -->
        <dependency>
            <groupId>com.kotharworks</groupId>
            <artifactId>wilds-headless</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <configuration>
                    <skip>false</skip>
                    <mainClass>com.kotharworks.wilds.server.Main</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
